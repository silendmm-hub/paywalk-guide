# Скопируй в .env и заполни. Файл .env никому не отправляй и в git не клади.

# --- Telegram
# от @BotFather
BOT_TOKEN=
# id группы клуба, вида -100...
CLUB_CHAT_ID=
# id старой группы (для скидки старичкам), можно пусто
OLD_CHAT_ID=
# твой Telegram id, можно несколько через запятую
ADMIN_IDS=
MANAGER_USERNAME=alphach_manager
CLUB_NAME=Блог без лица

# --- Цены, ₽ в месяц
PRICE=990
# цена для участников старой группы
OLD_PRICE=690
# сколько дней ждать после неудачного списания
GRACE_DAYS=3

# --- Точка
# JWT-ключ из интернет-банка: Интеграции и API
TOCHKA_JWT=
# client_id того же ключа, нужен для вебхука
TOCHKA_CLIENT_ID=
# покажет команда: python bot.py check
TOCHKA_CUSTOMER_CODE=
# тоже покажет check; нужен, если торговых точек несколько
TOCHKA_MERCHANT_ID=
TOCHKA_SANDBOX=0
# 1 = чеки через партнёра Точки (нужна почта покупателя)
RECEIPTS=1
# osn, usn_income, usn_income_outcome, esn, patent
TAX_SYSTEM=usn_income
VAT=none

# --- Сервер
# домен или 1-2-3-4.sslip.io, где 1.2.3.4 — IP сервера
DOMAIN=
# https:// + DOMAIN
PUBLIC_URL=
# любая длинная случайная строка, например из: openssl rand -hex 16
WEBHOOK_SECRET=
